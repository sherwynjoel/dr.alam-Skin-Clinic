# Dr. Alam's Skin Clinic - Clean URL Configuration
# Removes .html from the address bar

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Force apex (non-www) host
RewriteCond %{HTTP_HOST} ^www\.dralamdermcentre\.com$ [NC]
RewriteRule ^ https://dralamdermcentre.com%{REQUEST_URI} [R=301,L]

# 3. Redirect /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
RewriteRule ^index\.html$ / [R=301,L]

# 4. Redirect example.html to example
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html\ HTTP/
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# 5. Handle internal routing (show .html content for clean URLs)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)$ $1.html [L]
